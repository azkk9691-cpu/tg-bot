# ===================================================
# BULDROP PM - Telegram Bot Environment Configuration
# ===================================================

# 1. Telegram Bot Token (from @BotFather) [REQUIRED]
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Database Connection URL [REQUIRED]
# For SQLite (default, self-contained):
DATABASE_URL="file:./dev.db"

# 3. Main Admin Configuration [REQUIRED]
# Admin Telegram ID (Numeric ID from @userinfobot or @raw_data_bot)
ADMIN_TELEGRAM_ID=123456789

# Admin Telegram Username (reference)
ADMIN_USERNAME=yusupov_bro

# 4. Payment Settings
PAYMENT_CARD_NUMBER=6262910202797114
PAYMENT_CARD_HOLDER=BULDROP PM
PAYMENT_EXPIRE_MINUTES=5

# 5. Automatic Payment & Ads Settings
# Set to 'false' for ad-free experience (no mandatory channels)
REQUIRE_CHANNELS=false

# Telegram Stars exchange rate (1 Star = 250 UZS)
STARS_RATE=250

# CryptoBot Token (optional, for @CryptoBot automatic USDT/TON deposits)
CRYPTO_BOT_TOKEN=
CRYPTO_BOT_NET=mainnet

# 6. Hosting & System Settings
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

