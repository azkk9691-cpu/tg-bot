generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  telegramId      BigInt           @unique @map("telegram_id")
  username        String?          @map("username")
  firstName       String?          @map("first_name")
  balance         BigInt           @default(0) @map("balance")
  totalDeposited  BigInt           @default(0) @map("total_deposited")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  promoCodes      PromoCode[]      @relation("UserPromoCodes")
  paymentRequests PaymentRequest[]
  transactions    Transaction[]
  purchases       Purchase[]

  @@map("users")
}

model PromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique @map("code")
  category       String    @map("category") // '24_PM', '49_PM', '99_PM', '149_PM', '199_PM'
  price          BigInt    @map("price")
  status         String    @default("AVAILABLE") @map("status") // 'AVAILABLE', 'SOLD', 'RESERVED'
  soldToUserId   Int?      @map("sold_to_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  soldAt         DateTime? @map("sold_at")

  soldToUser     User?     @relation("UserPromoCodes", fields: [soldToUserId], references: [id], onDelete: SetNull)
  purchase       Purchase?

  @@index([category, status])
  @@index([status])
  @@map("promo_codes")
}

model PaymentRequest {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  amount         BigInt    @map("amount")
  receiptFileId  String?   @map("receipt_file_id")
  status         String    @default("PENDING") @map("status") // 'PENDING', 'WAITING_APPROVAL', 'APPROVED', 'REJECTED', 'EXPIRED'
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     BigInt?   @map("approved_by")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    Transaction?

  @@index([userId, status])
  @@index([status])
  @@map("payment_requests")
}

model Transaction {
  id               Int             @id @default(autoincrement())
  userId           Int             @map("user_id")
  type             String          @map("type") // 'DEPOSIT', 'PURCHASE', 'REFUND', 'ADMIN_ADJUST'
  amount           BigInt          @map("amount")
  status           String          @default("COMPLETED") @map("status") // 'PENDING', 'COMPLETED', 'REJECTED'
  description      String?         @map("description")
  paymentRequestId Int?            @unique @map("payment_request_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type, status])
  @@map("transactions")
}

model Purchase {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  promoCodeId Int       @unique @map("promo_code_id")
  category    String    @map("category")
  price       BigInt    @map("price")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("purchases")
}

model RequiredChannel {
  id              Int      @id @default(autoincrement())
  channelUsername String   @unique @map("channel_username")
  channelTitle    String   @default("Kanal") @map("channel_title")
  channelUrl      String   @map("channel_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("required_channels")
}

model SystemSetting {
  key         String   @id @map("key")
  value       String   @map("value")
  description String?  @map("description")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
